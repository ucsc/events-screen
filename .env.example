# Plausible Stats API key (plausible.io → Settings → API keys)
PLAUSIBLE_API_KEY=

# Time period the page covers (Plausible date range): day, 7d, 30d, month, 12mo, or any <N>d
UPCOMING_EVENTS_RANGE=30d

# Optional overrides
PLAUSIBLE_SITE_ID=events.ucsc.edu
PLAUSIBLE_API_HOST=https://plausible.io
EVENTS_SITE_URL=https://events.ucsc.edu
# IANA time zone used to decide what "today" is for the upcoming filter
EVENTS_TIMEZONE=America/Los_Angeles
